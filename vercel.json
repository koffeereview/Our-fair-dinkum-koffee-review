{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/sitemap.xml", "destination": "/api/sitemap" },
    { "source": "/review/:slug", "destination": "/api/review?slug=:slug" },
    { "source": "/city/:city", "destination": "/api/city?city=:city" },
    { "source": "/suburb/:suburb", "destination": "/api/suburb?suburb=:suburb" },
    { "source": "/best-latte-brisbane", "destination": "/api/best-latte-brisbane" },
    { "source": "/hidden-gem-cafes-brisbane", "destination": "/api/hidden-gems" },
    { "source": "/worst-cafes-by-suburb", "destination": "/api/worst-cafe" },
    { "source": "/worst-cafe-:suburb", "destination": "/api/worst-cafe" },
    { "source": "/brisbane-cafes-to-avoid", "destination": "/api/avoid" },
    { "source": "/leaderboard", "destination": "/api/leaderboard" },
    { "source": "/best-coffee-brisbane", "destination": "/api/best-coffee" },
    { "source": "/best-coffee-gold-coast", "destination": "/api/best-coffee" },
    { "source": "/best-coffee-sunshine-coast", "destination": "/api/best-coffee" },
    { "source": "/best-coffee-melbourne", "destination": "/api/best-coffee" },
    { "source": "/best-coffee-moreton-bay", "destination": "/api/best-coffee" },
    { "source": "/disclosure", "destination": "/disclosure.html" },
    { "source": "/about", "destination": "/about.html" },
    { "source": "/privacy", "destination": "/privacy.html" },
    { "source": "/coffee-near-me", "destination": "/api/near" },
    { "source": "/coffee-near/:landmark", "destination": "/api/near?landmark=:landmark" },
    { "source": "/map", "destination": "/api/map" },
    { "source": "/compare", "destination": "/api/compare" },
    { "source": "/blog", "destination": "/api/blog" },
    { "source": "/blog/:slug", "destination": "/api/blog?slug=:slug" },
    { "source": "/how-we-score", "destination": "/how-we-score.html" },
    { "source": "/embed/:slug", "destination": "/api/embed?slug=:slug" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
